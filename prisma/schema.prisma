generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model products_img {
  id         Int      @id @default(autoincrement())
  image_path String
  image_type String   @default("thumb")
  sku        String
  sort_order Int      @default(99)
  created_at DateTime @default(now())

  product    products @relation(fields: [sku], references: [sku], onDelete: Cascade)

  @@unique([sku, image_path])
}

model categories {
  id         Int          @id @default(autoincrement())
  nome       String
  parent_id  Int?
  image_path String?
  linha      String       @default("AGRICOLA")
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  parent     categories?  @relation("CategoryToCategory", fields: [parent_id], references: [id], onDelete: SetNull)
  children   categories[] @relation("CategoryToCategory")
  products   products[]
  agricolas  agricolas[]  @relation("AgricolaCategory")
}

model products {
  sku                  String       @id
  categoria            String?      @db.Text
  category_id          Int?
  linha                String       @default("AGRICOLA")
  created_at           DateTime     @default(now())
  descricao            String?      @db.Text
  estoque              Int          @default(0)
  imagem_principal     String?      @db.Text
  marca                String?      @db.Text
  nome                 String       @db.Text
  nome_es              String?      @db.Text
  descricao_es         String?      @db.Text
  peso                 Float?
  tamanho              String?      @db.Text
  altura               Float?
  largura              Float?
  valor_compra         Float?
  valor_promocional    Float?
  preco_brl            Float?
  veiculos_compativeis String?      @db.Text
  updated_at           DateTime     @updatedAt
  url                  String?      @db.Text
  codigo_fabricante    String?      @db.Text
  ean                  String?      @db.Text
  ncm                  String?      @db.Text
  profundidade         Float?

  category             categories?  @relation(fields: [category_id], references: [id], onDelete: SetNull)
  images               products_img[]
  aplicacoes           produto_aplicacao[]
  similares            produto_similar[]
  fichas_tecnicas      produto_ficha_tecnica[]
}

model produto_aplicacao {
  id         Int      @id @default(autoincrement())
  sku        String
  montadora  String
  veiculo    String
  ano        String?
  motor      String?
  
  product    products @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model produto_similar {
  id              Int      @id @default(autoincrement())
  sku             String
  codigo_similar  String
  marca_similar   String
  
  product         products @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model produto_ficha_tecnica {
  id         Int      @id @default(autoincrement())
  sku        String
  chave      String
  valor      String   @db.Text
  
  product    products @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model site_banners {
  id         Int      @id @default(autoincrement())
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  image_path String
  // Arte opcional para celular (o banner largo é cortado nas laterais em telas estreitas)
  image_path_mobile String?
  // Nome interno, usado também como texto alternativo da imagem
  titulo     String?
  kind       String
  link_url   String?
  position   Int      @default(0)
  linha      String   @default("AGRICOLA")
}

model site_visits {
  id           Int      @id @default(autoincrement())
  city         String?
  country      String?
  country_code String?
  created_at   DateTime @default(now())
  path         String
  referrer     String?
  region       String?
  user_agent   String?
  // Rastreio de visitantes (src/lib/rastreio.server.ts). O IP nunca é gravado: só um hash.
  visitor_id   String?  @db.VarChar(64)
  session_id   String?  @db.VarChar(64)
  ip_hash      String?  @db.VarChar(64)
  latitude     Float?
  longitude    Float?
  fonte        String?  @db.VarChar(40)  // google, instagram, facebook, whatsapp, direto...
  meio         String?  @db.VarChar(40)  // cpc, organico, social, referencia...
  utm_source   String?  @db.VarChar(100)
  utm_medium   String?  @db.VarChar(100)
  utm_campaign String?  @db.VarChar(150)
  referrer_host String? @db.VarChar(191)
  device       String?  @db.VarChar(20)
  browser      String?  @db.VarChar(40)
  os           String?  @db.VarChar(40)
  language     String?  @db.VarChar(20)
  entrada      Boolean  @default(false) // primeira página da sessão

  @@index([created_at])
  @@index([visitor_id])
  @@index([session_id])
}

model quotes {
  id         Int      @id @default(autoincrement())
  nome       String
  endereco   String
  whatsapp   String
  mensagem   String?  @db.Text
  file_path  String?
  status     String   @default("NOVA")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model agricolas {
  sku                  String       @id
  categoria            String?      @db.Text
  category_id          Int?
  created_at           DateTime     @default(now())
  descricao            String?      @db.Text
  estoque              Int          @default(0)
  imagem_principal     String?      @db.Text
  marca                String?      @db.Text
  nome                 String       @db.Text
  nome_es              String?      @db.Text
  descricao_es         String?      @db.Text
  peso                 Float?
  tamanho              String?      @db.Text
  altura               Float?
  largura              Float?
  valor_compra         Float?
  valor_promocional    Float?
  preco_brl            Float?
  veiculos_compativeis String?      @db.Text
  updated_at           DateTime     @updatedAt
  url                  String?      @db.Text
  codigo_fabricante    String?      @db.Text
  fabricante           String?      @db.Text // fabricante da peça (DANA, MWM, FERSA...)
  // Versão de outra peça com o mesmo código: fica oculta na loja e aparece na página do principal
  duplicado_de         String?      @db.VarChar(191)
  // false quando a marca é só o valor padrão da importação antiga e não pôde ser confirmada
  marca_confirmada     Boolean      @default(true)
  // Foto obtida automaticamente pela busca de imagens: página de origem (para remover se preciso)
  imagem_origem        String?      @db.Text
  // Quando a busca automática de imagem foi feita (evita pesquisar e pagar duas vezes)
  imagem_buscada_em    DateTime?
  ean                  String?      @db.Text
  ncm                  String?      @db.Text
  profundidade         Float?

  category             categories?  @relation("AgricolaCategory", fields: [category_id], references: [id], onDelete: SetNull)
  principal            agricolas?   @relation("AgricolaVariantes", fields: [duplicado_de], references: [sku], onDelete: SetNull)
  variantes            agricolas[]  @relation("AgricolaVariantes")
  images               agricolas_img[]
  aplicacoes           agricolas_aplicacao[]
  similares            agricolas_similar[]
  fichas_tecnicas      agricolas_ficha_tecnica[]
}

model agricolas_img {
  id         Int      @id @default(autoincrement())
  image_path String
  image_type String   @default("thumb")
  sku        String
  sort_order Int      @default(99)
  created_at DateTime @default(now())

  product    agricolas @relation(fields: [sku], references: [sku], onDelete: Cascade)
  @@unique([sku, image_path])
}

model agricolas_aplicacao {
  id         Int      @id @default(autoincrement())
  sku        String
  montadora  String
  veiculo    String
  ano        String?
  motor      String?
  
  product    agricolas @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model agricolas_similar {
  id              Int      @id @default(autoincrement())
  sku             String
  codigo_similar  String
  marca_similar   String
  
  product         agricolas @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model agricolas_ficha_tecnica {
  id         Int      @id @default(autoincrement())
  sku        String
  chave      String
  valor      String   @db.Text
  
  product    agricolas @relation(fields: [sku], references: [sku], onDelete: Cascade)
}

model homepage_blocks {
  id         Int      @id @default(autoincrement())
  type       String
  active     Boolean  @default(true)
  position   Int      @default(0)
  title      String?
  config     String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model users {
  id            Int      @id @default(autoincrement())
  nome_completo String
  email         String   @unique
  senha_hash    String
  telefone      String?
  endereco      String?  @db.Text
  cidade        String?
  ponto_referencia String? @db.Text
  numero_casa   String?
  cep           String?
  pais          String?  @default("Uruguai")
  role          String   @default("USER")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  // Login com Google e perfil do cliente
  google_id     String?  @unique @db.VarChar(64)
  avatar_url    String?  @db.Text
  departamento  String?  @db.VarChar(40)
  ultimo_login  DateTime?
  // E-mails de marketing: o cliente pode sair pelo link "darse de baja" de cada e-mail
  recebe_emails Boolean  @default(true)

  downloads     catalogos_downloads[]
  carrinhos     carrinhos[]
}

// Catálogos e manuais em PDF para mecânicos (página /catalogos). Arquivos em <uploads>/catalogos.
model catalogos {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(200)
  marca       String?  @db.VarChar(60)
  tipo        String   @default("Catálogo de piezas") @db.VarChar(60)
  descricao   String?  @db.Text
  arquivo     String   @db.VarChar(255) // caminho relativo dentro de <uploads>/catalogos
  tamanho     BigInt   @default(0)
  idioma      String?  @db.VarChar(20)
  ativo       Boolean  @default(false) // só aparece no site quando publicado
  exige_login Boolean  @default(true)
  downloads   Int      @default(0)
  ordem       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  registros   catalogos_downloads[]
}

model catalogos_downloads {
  id          Int       @id @default(autoincrement())
  catalogo_id Int
  user_id     Int?
  created_at  DateTime  @default(now())

  catalogo    catalogos @relation(fields: [catalogo_id], references: [id], onDelete: Cascade)
  user        users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([catalogo_id])
  @@index([user_id])
}

// Carrinhos (lista de cotação) salvos no servidor a cada mudança, para o painel de vendas.
// Um visitante tem no máximo um carrinho ABERTO; ao pedir preço pelo WhatsApp vira ENVIADO.
model carrinhos {
  id            Int       @id @default(autoincrement())
  visitante_id  String    @db.VarChar(64)
  user_id       Int?
  itens         String    @db.Text // JSON: [{sku, codigo, name, nameEs, image, quantity}]
  qtd_itens     Int       @default(0)
  status        String    @default("ABERTO") @db.VarChar(20) // ABERTO, ENVIADO
  etapa         String    @default("NOVO") @db.VarChar(20) // NOVO, CONTATADO, NEGOCIANDO, GANHO, PERDIDO
  nota          String?   @db.Text
  valor_fechado Float?
  contatos      Int       @default(0)
  contatado_em  DateTime?
  enviado_em    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user          users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([visitante_id])
  @@index([user_id])
  @@index([updated_at])
}

// Campanhas de e-mail (Resend). O conteúdo é o JSON do editor; o HTML é gerado no envio.
model email_campanhas {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(150)
  assunto    String    @db.VarChar(200)
  preheader  String?   @db.VarChar(200)
  conteudo   String    @db.LongText
  publico    String    @db.Text
  status     String    @default("RASCUNHO") @db.VarChar(20) // RASCUNHO, ENVIANDO, ENVIADA, ERRO
  total      Int       @default(0)
  enviados   Int       @default(0)
  falhas     Int       @default(0)
  erro       String?   @db.Text
  enviado_em DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  envios     email_envios[]
}

// Cada e-mail enviado. O status é atualizado pelo webhook do Resend (entregue, aberto, clicado...).
model email_envios {
  id          Int       @id @default(autoincrement())
  campanha_id Int?
  user_id     Int?
  email       String    @db.VarChar(191)
  tipo        String    @default("CAMPANHA") @db.VarChar(20) // CAMPANHA, CARRINHO, TESTE
  status      String    @default("ENVIADO") @db.VarChar(20) // ENVIADO, ENTREGUE, ABERTO, CLICADO, REBOTADO, QUEIXA, FALHA
  resend_id   String?   @db.VarChar(64)
  erro        String?   @db.Text
  aberto_em   DateTime?
  clicado_em  DateTime?
  created_at  DateTime  @default(now())

  campanha    email_campanhas? @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  @@index([campanha_id])
  @@index([user_id])
  @@index([resend_id])
}
